# Version control & CI
.git
.github
.gitignore
.gitattributes

# Local env & secrets — never bake these into an image
.env
.env.*
!.env.example
!.env.production.example

# Dependencies (installed inside the image, not copied from the host)
/node_modules
/vendor

# Build output (rebuilt inside the image)
/public/build
/public/hot

# Local dev / IDE
.idea
.vscode
.claude
.fleet

# Laravel runtime/cache artifacts that must not ship with the image
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/storage/inertia-devtools
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
/database/*.sqlite

# Tests, docs, and tooling that don't need to be in the runtime image
/tests
/.phpunit.cache
phpunit.xml
/docs
*.md
!README.md

# Misc
Dockerfile
.dockerignore
docker-compose*.yml
Thumbs.db
.DS_Store
