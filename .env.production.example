# ------------------------------------------------------------------------
# Production environment variables for Railway.
#
# This file is a REFERENCE, not something Railway reads automatically.
# Copy each variable into the Railway dashboard (Project → each service →
# Variables) — the "web" and "worker" services need the same values,
# except where noted otherwise below.
#
# See docs/deployment-railway.md for the full setup walkthrough, and in
# particular for why DB_URL is used instead of a literal DATABASE_URL.
# ------------------------------------------------------------------------

# --- Core Laravel ---
APP_NAME="TerangaTicket"
APP_ENV=production
# Generate once locally with `php artisan key:generate --show` and paste
# the result here. Never rotate this on every deploy — it invalidates all
# existing sessions and any encrypted database columns.
APP_KEY=
APP_DEBUG=false
# The public HTTPS URL Railway assigns this service (or your custom
# domain). Required for correct URL generation (Wave redirect URLs, email
# links to checkout.ticket-pdf, asset URLs, etc.).
APP_URL=https://your-app.up.railway.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# --- Database (MySQL) ---
# Railway's MySQL plugin injects a variable named MYSQL_URL (NOT
# DATABASE_URL — that naming is a Postgres/Heroku convention). This app's
# config/database.php reads the connection string from DB_URL, so alias
# Railway's variable to it using Railway's variable-reference syntax
# instead of typing a literal value:
#
#   DB_CONNECTION=mysql
#   DB_URL=${{MySQL.MYSQL_URL}}
#
# Replace `MySQL` with whatever you actually named the MySQL service in
# your Railway project. Set both lines directly in the Railway dashboard —
# leave them commented out here since this file has no database attached.
# DB_CONNECTION=mysql
# DB_URL=${{MySQL.MYSQL_URL}}

# --- Cache / Session / Queue ---
# All three default to the `database` driver already, which needs no extra
# service on Railway (uses the same MySQL connection as everything else).
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
QUEUE_CONNECTION=database

# --- Logging ---
# Railway captures container stdout/stderr as the service's log stream —
# "stderr" avoids writing to a local (ephemeral) storage/logs/*.log file.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Filesystem ---
# ⚠️ See the "Persistent storage" section in docs/deployment-railway.md
# before going live: `local` writes to the container's disk, which is
# ephemeral AND not shared between the web and worker services. Ticket QR
# codes are generated by the worker but served by the web service, so this
# WILL break in production unless you switch to an S3-compatible disk
# (Cloudflare R2, AWS S3, Backblaze B2 all work with Laravel's `s3` driver)
# or otherwise share storage between both services.
FILESYSTEM_DISK=local

# --- Sanctum (Flutter scanner app) ---
# Comma-separated list of hosts allowed to receive stateful (cookie-based)
# Sanctum requests. The scanner app authenticates via Bearer token, not
# cookies, so this mainly matters if you ever add a first-party SPA client
# on another domain.
SANCTUM_STATEFUL_DOMAINS=your-app.up.railway.app

# --- App-specific: ticket signing ---
# Generate with: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
# Never reuse the local development value — tickets already issued with a
# different secret will fail signature verification if this changes later.
APP_TICKET_SECRET=

# --- App-specific: payments ---
# Keep this false until Wave credentials below are filled in and verified
# — with it false (or any ticket type priced at 0), checkout bypasses Wave
# entirely and orders are marked paid immediately. See docs/deployment-railway.md.
PAYMENT_ENABLED=false
WAVE_SECRET_KEY=
WAVE_WEBHOOK_SECRET=

# --- App-specific: Twilio (WhatsApp/SMS ticket delivery) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- Mail (order confirmation emails) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
